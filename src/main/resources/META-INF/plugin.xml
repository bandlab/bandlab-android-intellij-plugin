<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.bandlab.intellij.plugin</id>
    <name>BandLab Android Convention</name>
    <vendor>BandLab</vendor>

    <dependencies>
        <plugin id="com.intellij.java"/>
        <plugin id="org.jetbrains.kotlin"/>
        <plugin id="org.jetbrains.android"/>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.libraries.compose.foundation.desktop"/>
        <module name="intellij.libraries.skiko"/>
    </dependencies>

    <extensions defaultExtensionNs="com.android">
        <moduleDescriptionProvider
                implementation="com.bandlab.intellij.plugin.module.BandLabModuleDescriptionProvider"
                id="bandlab_convention"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Gradle project path support -->
        <completion.contributor
                language="Groovy"
                implementationClass="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectCompletionContributor"/>
        <completion.contributor
                language="kotlin"
                implementationClass="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectCompletionContributor"/>
        <annotator
                language="Groovy"
                implementationClass="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectAnnotator"/>
        <annotator
                language="kotlin"
                implementationClass="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectAnnotator"/>
        <psi.referenceContributor
                language="Groovy"
                implementation="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectReferenceContributor"/>
        <psi.referenceContributor
                language="kotlin"
                implementation="com.bandlab.intellij.plugin.dependencies.autocomplete.GradleProjectReferenceContributor"/>
        <intentionAction>
            <className>com.bandlab.intellij.plugin.dependencies.autocomplete.RefreshProjectPathsIntentionAction
            </className>
            <category>Gradle</category>
        </intentionAction>
        <intentionAction>
            <className>com.bandlab.intellij.plugin.strings.DeleteStringIntention</className>
            <category>Localizer</category>
        </intentionAction>
        <intentionAction>
            <className>com.bandlab.intellij.plugin.strings.UpdateStringIntention</className>
            <category>Localizer</category>
        </intentionAction>
        <editorNotificationProvider
                implementation="com.bandlab.intellij.plugin.strings.LocalizerStringFileNotificationProvider"/>
        <notificationGroup id="bandlab-localizer" displayType="BALLOON"/>
        <typedHandler implementation="com.bandlab.intellij.plugin.localizer.LocalizerEditWarningTypedHandler"/>
        <applicationConfigurable parentId="tools"
                                 instance="com.bandlab.intellij.plugin.localizer.LocalizerSettingsConfigurable"
                                 id="settings.bandlab.localizer"
                                 displayName="Localizer"/>
    </extensions>

    <!-- Adds "Localizer: Add string" to the red error-fix section on an unresolved R.string/R.plurals
         reference (the key doesn't exist yet), via the Kotlin K2 UNRESOLVED_REFERENCE diagnostic.
         The diagnostic API is FIR/K2-only, so the plugin declares K2 mode support. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
        <codeinsight.quickfix.registrar
                implementation="com.bandlab.intellij.plugin.strings.AddStringUnresolvedQuickFixRegistrar"/>
    </extensions>

    <actions>
        <action id="PageTemplateCreateAction"
                class="com.bandlab.intellij.plugin.template.PageTemplateCreateAction" text="Page Template">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="Android.CreateResourcesActionGroup"/>
        </action>

        <action id="TwoLevelInjectionTemplateCreateAction"
                class="com.bandlab.intellij.plugin.template.TwoLevelInjectionTemplateCreateAction"
                text="2-level Injection Template">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="PageTemplateCreateAction"/>
        </action>

        <action id="AutomationTemplateCreateAction"
                class="com.bandlab.intellij.plugin.automation.AutomationTemplateCreateAction"
                text="Automation Template">
            <add-to-group group-id="NewGroup" anchor="after"
                          relative-to-action="TwoLevelInjectionTemplateCreateAction"/>
        </action>

        <action id="SortDependenciesAction"
                class="com.bandlab.intellij.plugin.dependencies.sort.SortDependenciesAction" text="Sort Dependencies">
            <add-to-group group-id="ProjectViewPopupMenuModifyGroup" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu1" anchor="first"/>
        </action>

        <action id="ApplyTestFixturesPluginAction"
                class="com.bandlab.intellij.plugin.test.fixtures.ApplyTestFixturesPluginAction" text="Test Fixtures">
            <add-to-group group-id="ProjectViewPopupMenuModifyGroup" anchor="after"
                          relative-to-action="SortDependenciesAction"/>
            <add-to-group group-id="EditorPopupMenu1" anchor="after" relative-to-action="SortDependenciesAction"/>
        </action>

        <action id="ModuleAnalysisAction"
                class="com.bandlab.intellij.plugin.analysis.ModuleAnalysisAction" text="Analyze Module">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="before"
                          relative-to-action="AnalyzeMenu"/>
        </action>

        <!-- File/dialog-level Localizer commands, grouped under a "Localizer" submenu in the Tools
             menu, Project View popup, and editor popup. Available whenever the project has a
             resolved bandlab-localizer-config.toml — no file context or Gradle sync needed. The
             caret-level "Delete String" is an Alt+Enter intention (see DeleteStringIntention). -->
        <!-- NOT in EditorPopupMenu — IntelliJ surfaces editor-popup actions in the Alt+Enter context
             list, so a menu entry there leaks into the intention popup. In the editor the warning
             banner + the intentions cover it; the submenu lives in Tools menu + Project View. -->
        <group id="LocalizerMenu" text="Localizer" popup="true" icon="/drawable/product-bandlab.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="before" relative-to-action="ModuleAnalysisAction"/>
            <action id="UpdateStringsAction"
                    class="com.bandlab.intellij.plugin.strings.UpdateStringsAction" text="Update Strings"/>
            <action id="AddStringsAction"
                    class="com.bandlab.intellij.plugin.strings.AddStringsAction" text="Add Strings"/>
            <action id="DeleteStringsAction"
                    class="com.bandlab.intellij.plugin.strings.DeleteStringsAction" text="Delete Strings"/>
        </group>
    </actions>
</idea-plugin>
